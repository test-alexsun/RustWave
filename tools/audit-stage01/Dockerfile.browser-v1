FROM oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS bun
FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium=156.0.8078.73-1~deb12u1 chromium-common=156.0.8078.73-1~deb12u1 \
    && rm -rf /var/lib/apt/lists/*
ENV TZ=UTC LC_ALL=C.UTF-8 CHROMIUM_BIN=/usr/bin/chromium
